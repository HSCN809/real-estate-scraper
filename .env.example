# Real Estate Scraper - Environment Variables

# ==================== DATABASE ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate
DATABASE_URL=postgresql://postgres:postgres@real-estate-db:5432/real_estate

# ==================== REDIS ====================
REDIS_URL=redis://real-estate-redis:6379/0

# ==================== FASTAPI ====================
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== SCRAPING ====================
HEPSIEMLAK_MAX_PAGES=50
EMLAKJET_MAX_PAGES=50
CHROME_HEADLESS=true

# ==================== GO PROXY ====================
# Proxy sunucusu ayarları
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
PROXY_READ_TIMEOUT=30
PROXY_WRITE_TIMEOUT=30

# TLS Parmak İzi Ayarları
TLS_CLIENT_ID=HelloChrome_120
TLS_ROTATE=true
TLS_ROTATE_LIST=HelloChrome_120,HelloChrome_119,HelloChrome_118,HelloFirefox_120,HelloEdge_120

# User Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Mobile Proxy (Opsiyonel)
# MOBILE_PROXY_URL=socks5://user:pass@mobile-proxy.com:port
# MOBILE_PROXY_USER=username
# MOBILE_PROXY_PASS=password

# Güvenlik
PROXY_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://real-estate-frontend:3000,http://localhost:8000,http://real-estate-api:8000

# Rate Limiting
RATE_LIMIT=10
RATE_LIMIT_BURST=20

# Bağlantı Havuzu
MAX_IDLE_CONNS=100
MAX_IDLE_CONNS_PER_HOST=10
IDLE_CONN_TIMEOUT=90

# Yeniden Deneme
MAX_RETRIES=3
RETRY_DELAY=1000

# Debug
DEBUG=false

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_HEPSIEMLAK_MAX_PAGES=50
NEXT_PUBLIC_HEPSIEMLAK_MIN_PAGES=1
NEXT_PUBLIC_EMLAKJET_MAX_PAGES=50
NEXT_PUBLIC_EMLAKJET_MIN_PAGES=1

# ==================== FLOWER ====================
FLOWER_BASIC_AUTH=admin:admin123

# ==================== WORKER ====================
GO_PROXY_URL=http://invisible-proxy:8080
USE_GO_PROXY=true
LOG_FILE=/tmp/scraper-logs/scraper.log
LOG_FALLBACK_DIR=/tmp/scraper-logs
